#!/data/data/com.termux/files/usr/bin/bash
# =============================================================================
# org-media — generalized media organizer (extends org-camera-album)
# =============================================================================
# SUMMARY: Move photos/videos from Camera, Edits, Muse, Screenshots...
# GROUP: media
#
# No arguments: sweeps the four accumulation points (Camera, Edits, Muse,
#   Screenshots), prompts for a NEW folder name, moves all media, rescans
#   the gallery. No confirmation dialog -- the same prompt/move/rescan flow
#   org-camera-album always had, just with a wider net.
#   For the strict original (Camera only, e.g. pipelines): --source camera
#
# Extra behavior via flags (any flag beyond the pure default enables the
# dry-run preview + confirmation step, unless --yes):
#   --source camera|screenshots|downloads|edits|muse|<path>[,...]
#              (comma-separated = multi-source, e.g. --source camera,edits)
#   --dest <name|path>            (default: prompt for NEW folder, like the original)
#   --type photos|videos|all      (default: all)
#   --older-than N                (days; default: no age filter)
#   --match <pattern>             (filename substring, case-insensitive)
#   --dated                       (move into <dest>/YYYY-MM-DD/)
#   --dry-run                     (preview only, move nothing)
#   --yes                         (skip the confirmation prompt)
#   --interactive                 (pickers even when flags cover everything)
#   --help
#
# Examples:
#   org-media                                # sweep Camera+Edits+Muse+Screenshots
#   org-media --source camera                # strict original (Camera only)
#   org-media --source camera,edits --dest shoot_may --yes
#   org-media --source screenshots --dest screenshots --dated --yes
#   org-media --source downloads --older-than 7 --dry-run
#   org-media --source edits --type videos --match final
#
# Safety: never overwrites (existing names are skipped and reported), writes
# a move manifest per run to .hidden/org-media-manifests/ (undo fuel).
# =============================================================================

SHARED="$HOME/storage/shared"
HIDDEN="$HOME/.shortcuts/.hidden"
MANIFEST_DIR="$HIDDEN/org-media-manifests"


# --- dialog helpers: announce the popup before blocking on it ---------------
# Widget runs show the terminal but the dialog is a separate popup; without
# this notice the script looks stuck "expecting something".
dlg_text() {    # $1 = title ; echoes the entered text on stdout
    echo "  [waiting on dialog] $1 -- check the popup on your screen" >&2
    termux-dialog text -t "$1" | jq -r '.text // ""'
}
dlg_radio() {   # $1 = comma-separated values, $2 = title ; echoes the picked value
    echo "  [waiting on dialog] $2 -- check the popup on your screen" >&2
    termux-dialog radio -v "$1" -t "$2" | jq -r '.text // ""'
}
dlg_confirm() { # $1 = title, $2 = hint ; echoes exactly "yes" or "no"
    # NOTE: the notice goes to stderr -- stdout is the captured answer.
    echo "  [waiting on dialog] $1 -- check the popup on your screen" >&2
    local out ans code
    out=$(termux-dialog confirm -t "$1" -i "$2" 2>/dev/null)
    ans=$(printf '%s' "$out" | jq -r '.text // ""' 2>/dev/null)
    case "${ans,,}" in
        yes|y) echo "yes"; return ;;
        no|n)  echo "no"; return ;;
    esac
    # fall back to the button code when .text is missing (-1 = YES, -2 = NO)
    code=$(printf '%s' "$out" | jq -r '.code // empty' 2>/dev/null)
    [ "$code" = "-1" ] && echo "yes" || echo "no"
}

usage() {
    sed -n '2,/^# Safety/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}

# --- arg parsing -------------------------------------------------------------
SOURCE_ARG="" DEST_ARG="" TYPE="all" OLDER_THAN="" MATCH=""
DATED=0 DRY_RUN=0 YES=0 INTERACTIVE=0 PURE_DEFAULT=1

while [ $# -gt 0 ]; do
    case "$1" in
        --source)     SOURCE_ARG="$2"; PURE_DEFAULT=0; shift 2 ;;
        --dest)       DEST_ARG="$2";   PURE_DEFAULT=0; shift 2 ;;
        --type)       TYPE="$2";       PURE_DEFAULT=0; shift 2 ;;
        --older-than) OLDER_THAN="$2"; PURE_DEFAULT=0; shift 2 ;;
        --match)      MATCH="$2";      PURE_DEFAULT=0; shift 2 ;;
        --dated)      DATED=1;         PURE_DEFAULT=0; shift ;;
        --dry-run)    DRY_RUN=1;       PURE_DEFAULT=0; shift ;;
        --yes)        YES=1;           PURE_DEFAULT=0; shift ;;
        --interactive) INTERACTIVE=1;  PURE_DEFAULT=0; shift ;;
        --help|-h)    usage ;;
        *) echo "x unknown arg: $1 (see --help)"; exit 1 ;;
    esac
done

case "$TYPE" in
    photos|videos|all) ;;
    *) echo "x --type must be photos|videos|all"; exit 1 ;;
esac

[ ! -d "$SHARED" ] && echo "x $SHARED not found -- run termux-setup-storage" && exit 1

# --- preflight: fail fast with a clear message, not a mystery ---------------
for _cmd in termux-dialog jq; do
    command -v "$_cmd" >/dev/null 2>&1 || { echo "x missing required command: $_cmd -- run: pkg install termux-api jq"; exit 1; }
done
unset _cmd

# --- run logging: widget sessions vanish on exit, the log does not ----------
RUN_LOG_DIR="$HIDDEN/org-media-runs"
mkdir -p "$RUN_LOG_DIR" "$MANIFEST_DIR"
ls -t "$RUN_LOG_DIR"/org-media-*.log 2>/dev/null | tail -n +21 | xargs -r rm -f
RUN_LOG="$RUN_LOG_DIR/org-media-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee "$RUN_LOG") 2>&1
echo "=== org-media run: $(date '+%Y-%m-%d %H:%M:%S') ==="
echo "    run log: $RUN_LOG"

# --- source resolution -------------------------------------------------------
resolve_source() {
    case "$1" in
        camera) echo "$SHARED/DCIM/Camera" ;;
        screenshots)
            for p in "$SHARED/DCIM/Screenshots" "$SHARED/Pictures/Screenshots"; do
                [ -d "$p" ] && { echo "$p"; return 0; }
            done
            return 1 ;;
        downloads|download) echo "$SHARED/Download" ;;
        edits|edit)
            for p in "$SHARED/Edits" "$SHARED/edits" "$SHARED/DCIM/Edits" "$SHARED/Movies/Edits"; do
                [ -d "$p" ] && { echo "$p"; return 0; }
            done
            return 1 ;;
        muse)
            for p in "$SHARED/Muse" "$SHARED/DCIM/Muse" "$SHARED/Pictures/Muse"; do
                [ -d "$p" ] && { echo "$p"; return 0; }
            done
            return 1 ;;
        *)
            [ -d "$1" ] && echo "$1" && return 0
            [ -d "$SHARED/$1" ] && echo "$SHARED/$1" && return 0
            return 1 ;;
    esac
}

count_media() {  # $1 = dir; prints file count of media types
    [ -d "$1" ] || { echo 0; return; }
    find "$1" -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.mov' -o -iname '*.3gp' \
        -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.jpg' -o -iname '*.jpeg' \
        -o -iname '*.png' -o -iname '*.heic' -o -iname '*.gif' -o -iname '*.webp' \) | wc -l | tr -d ' '
}

pick_sources_checkbox() {
    # Multi-select source picker. Echoes one source key per line (may be
    # empty if dismissed). termux-dialog checkbox returns "[a, b]" style.
    local raw item
    echo "  [waiting on dialog] Sources? (tap all that apply) -- check the popup on your screen" >&2
    raw=$(termux-dialog checkbox -v "camera,screenshots,downloads,edits,muse,custom" \
        -t "Sources? (tap all that apply)" | jq -r '.text // ""')
    raw=${raw#\[}; raw=${raw%\]}
    local IFS=','
    for item in $raw; do
        item=$(printf '%s' "$item" | sed 's/^ *//;s/ *$//')
        [ -n "$item" ] && echo "$item"
    done
}

choose_sources() {
    # Checkbox-driven source selection; echoes a comma-separated source spec,
    # expanding "custom" via a text prompt. May echo empty (dismissed).
    local keys key out="" p
    keys=$(pick_sources_checkbox)
    [ -z "$keys" ] && return 0
    while IFS= read -r key; do
        if [ "$key" = "custom" ]; then
            p=$(dlg_text "Source path (absolute, or under shared/)")
            [ -n "$p" ] && out="$out,$p"
        else
            out="$out,$key"
        fi
    done <<< "$keys"
    echo "${out#,}"
}

build_source_set() {
    # $1 = comma-separated source spec, $2 = quiet (1 = suppress warnings).
    # Populates SRC_KEYS / SRC_PATHS with the sources that resolve.
    local spec="$1" quiet="${2:-0}" item p
    SRC_KEYS=(); SRC_PATHS=()
    local IFS=','
    for item in $spec; do
        item=$(printf '%s' "$item" | sed 's/^ *//;s/ *$//')
        [ -z "$item" ] && continue
        if p=$(resolve_source "$item" 2>/dev/null); then
            SRC_KEYS+=("$item"); SRC_PATHS+=("$p")
        elif [ "$quiet" != "1" ]; then
            echo "! skipping unknown source: $item" >&2
        fi
    done
}

# The four accumulation points swept by default (no-arg widget flow).
DEFAULT_SOURCES="camera,edits,muse,screenshots"

SOURCE_EXPLICIT=0
[ -n "$SOURCE_ARG" ] && SOURCE_EXPLICIT=1

collect_files() {
    # Gather matching files across ALL of SRC_PATHS. Populates FILES, COUNT,
    # and per-source SRC_COUNTS (parallel to SRC_KEYS/SRC_PATHS).
    FILES=(); SRC_COUNTS=()
    local sp n
    for sp in "${SRC_PATHS[@]}"; do
        n=0
        if [ -d "$sp" ]; then
            FIND_ARGS=("$sp" -maxdepth 1 -type f)
            case "$TYPE" in
                photos) EXTS="jpg jpeg png heic gif webp" ;;
                videos) EXTS="mp4 mov 3gp webm mkv" ;;
                all)    EXTS="jpg jpeg png heic gif webp mp4 mov 3gp webm mkv" ;;
            esac
            NAME_ARGS=()
            for e in $EXTS; do NAME_ARGS+=(-o -iname "*.$e"); done
            FIND_ARGS+=(\( "${NAME_ARGS[@]:1}" \))
            [ -n "$OLDER_THAN" ] && FIND_ARGS+=(-mtime +"$OLDER_THAN")
            [ -n "$MATCH" ] && FIND_ARGS+=(-iname "*${MATCH}*")
            while IFS= read -r -d ''; do
                FILES+=("$REPLY"); n=$((n+1))
            done < <(find "${FIND_ARGS[@]}" -print0 2>/dev/null | sort -z)
        fi
        SRC_COUNTS+=("$n")
    done
    COUNT=${#FILES[@]}
}

show_available_sources() {
    echo "  What's available right now:"
    local key p n
    for key in camera edits muse screenshots downloads; do
        p=$(resolve_source "$key" 2>/dev/null) || continue
        n=$(count_media "$p")
        echo "    $key: $n file(s)"
    done
}

# Foolproof source loop: an empty source set never dead-ends -- show what's
# available and offer the picker. Explicit --source / --yes runs keep the
# old exit-0 behavior for pipelines.
attempt=0
while true; do
    attempt=$((attempt + 1))
    if [ "$attempt" -eq 1 ]; then
        if [ -n "$SOURCE_ARG" ]; then
            build_source_set "$SOURCE_ARG" 0
        elif [ "$INTERACTIVE" -eq 1 ]; then
            SPEC=$(choose_sources)
            [ -z "$SPEC" ] && { echo "No sources selected. Exiting."; exit 0; }
            build_source_set "$SPEC" 0
        else
            build_source_set "$DEFAULT_SOURCES" 1   # quiet: optional dirs may not exist
        fi
    else
        SPEC=$(choose_sources)   # retry: always via picker
        [ -z "$SPEC" ] && { echo "No sources selected. Exiting."; exit 0; }
        build_source_set "$SPEC" 0
    fi
    if [ "${#SRC_PATHS[@]}" -eq 0 ]; then
        echo "x none of the selected sources exist on this device"
        [ "$attempt" -ge 3 ] && exit 1
        continue
    fi
    collect_files
    [ "$COUNT" -gt 0 ] && break
    echo "! no matching files across: ${SRC_KEYS[*]}"
    if [ "$SOURCE_EXPLICIT" -eq 1 ] || [ "$YES" -eq 1 ] || [ "$attempt" -ge 3 ]; then
        exit 0
    fi
    if [ "$PURE_DEFAULT" -eq 1 ] || [ "$INTERACTIVE" -eq 1 ]; then
        show_available_sources
        ans=$(dlg_confirm "Pick different sources?" "The current set came up empty")
        [ "$ans" = "yes" ] || exit 0
    else
        exit 0
    fi
done

TOTAL_BYTES=$(du -cb "${FILES[@]}" 2>/dev/null | tail -n1 | cut -f1)
HUMAN_SIZE=$(numfmt --to=iec-i "$TOTAL_BYTES" 2>/dev/null || echo "${TOTAL_BYTES}B")

# --- destination -------------------------------------------------------------
pick_dest_interactive() {
    local opts=""
    for d in "$SHARED"/*/; do
        [ -d "$d" ] || continue
        local base
        base=$(basename "$d")
        case "$base" in
            DCIM|Download|Android|Export|.*) continue ;;
        esac
        opts="${opts:+$opts,}$base"
    done
    opts="${opts:+$opts,}New folder..."    local pick
    pick=$(dlg_radio "$opts" "Destination folder?")
    [ -z "$pick" ] && { echo "No destination chosen. Exiting."; exit 0; }
    if [ "$pick" = "New folder..." ]; then
        pick=$(dlg_text "Enter NEW folder name")
        [ -z "$pick" ] && { echo "No folder name entered. Exiting."; exit 0; }
    fi
    echo "$pick"
}

if [ -n "$DEST_ARG" ]; then
    DEST_NAME="$DEST_ARG"
elif [ "$INTERACTIVE" -eq 1 ]; then
    DEST_NAME=$(pick_dest_interactive)
else
    # original behavior: prompt for a NEW folder name
    DEST_NAME=$(dlg_text "Enter NEW folder name to create in shared storage (e.g., 'Camera_Backup')")
    [ -z "$DEST_NAME" ] && { echo "No folder name entered. Exiting gracefully."; exit 0; }
fi

case "$DEST_NAME" in
    /*) DEST_PATH="$DEST_NAME" ;;
    *)  DEST_PATH="$SHARED/$DEST_NAME" ;;
esac
[ "$DATED" -eq 1 ] && DEST_PATH="$DEST_PATH/$(date +%Y-%m-%d)"

# --- preview + confirm -------------------------------------------------------
echo "--------------------------------------------------------"
echo "Sources:"
for i in "${!SRC_PATHS[@]}"; do
    echo "    ${SRC_KEYS[$i]}: ${SRC_COUNTS[$i]} file(s)  (${SRC_PATHS[$i]})"
done
echo "Destination: $DEST_PATH"
echo "Files:       $COUNT ($HUMAN_SIZE)"
echo "Filters:     type=$TYPE${OLDER_THAN:+, older-than=${OLDER_THAN}d}${MATCH:+, match='$MATCH'}"
echo "Sample:"
for f in "${FILES[@]:0:8}"; do echo "  $(basename "$f")"; done
[ "$COUNT" -gt 8 ] && echo "  ... and $((COUNT - 8)) more"
echo "--------------------------------------------------------"

if [ "$DRY_RUN" -eq 1 ]; then
    echo "DRY RUN -- nothing moved."
    exit 0
fi

if [ "$PURE_DEFAULT" -eq 0 ] && [ "$YES" -eq 0 ]; then
    ans=$(dlg_confirm "Move $COUNT files ($HUMAN_SIZE)?" "${SRC_KEYS[*]} -> $DEST_PATH")
    if [ "$ans" != "yes" ]; then
        echo "Cancelled. Nothing moved."
        exit 0
    fi
fi

# --- move --------------------------------------------------------------------
mkdir -p "$DEST_PATH" "$MANIFEST_DIR" || { echo "x cannot create $DEST_PATH"; exit 1; }
MANIFEST="$MANIFEST_DIR/org-media-$(date +%Y%m%d-%H%M%S).log"
{
    echo "# org-media run $(date '+%Y-%m-%d %H:%M:%S')"
    echo "# sources: ${SRC_KEYS[*]}"
} > "$MANIFEST"

moved=0; skipped=0
for f in "${FILES[@]}"; do
    base=$(basename "$f")
    if [ -e "$DEST_PATH/$base" ]; then
        skipped=$((skipped + 1))
        continue
    fi
    if mv "$f" "$DEST_PATH/"; then
        printf '%s\t%s\n' "$f" "$DEST_PATH/$base" >> "$MANIFEST"
        moved=$((moved + 1))
    fi
done

termux-media-scan -r "$DEST_PATH" 2>/dev/null
for sp in "${SRC_PATHS[@]}"; do termux-media-scan -r "$sp" 2>/dev/null; done

echo "--------------------------------------------------------"
echo "OK moved $moved file(s) -> $DEST_PATH"
[ "$skipped" -gt 0 ] && echo "! skipped $skipped (name already exists in destination)"
echo "Manifest: $MANIFEST"
echo "--------------------------------------------------------"
