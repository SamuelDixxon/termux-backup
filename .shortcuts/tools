#!/data/data/com.termux/files/usr/bin/bash
# =============================================================================
# tools — render the tool inventory
# =============================================================================
# SUMMARY: List all installed pipeline tools, grouped, with one-line descriptions
# GROUP: utility
#
#   tools            full grouped table (for humans)
#
# Convention: every tool script declares its one-liner in its header:
#   # SUMMARY: what it does in one line
#   # GROUP: pipeline|media|backup|content|utility
# Stateless by design (v4.4.21): the old --banner mode diffed mtimes
# against a .tools_seen cache that lived inside the mirrored
# ~/.shortcuts tree, so sync-in/backup-all kept resetting it and the
# banner showed phantom NEW/UPD noise. No cache, no mtimes, no
# startup banner — run `tools` when you want the inventory.
# =============================================================================

SHORTCUTS="${SHORTCUTS_DIR:-$HOME/.shortcuts}"
GROUP_ORDER="pipeline media backup content utility"

scan() {
    local f name summary group
    for f in "$SHORTCUTS"/*; do
        [ -f "$f" ] || continue
        name=$(basename "$f")
        case "$name" in
            *.md|.*) continue ;;   # docs and dotfiles aren't tools
        esac
        summary=$(grep -m1 '^# SUMMARY:' "$f" 2>/dev/null | sed 's/^# SUMMARY: *//')
        group=$(grep -m1 '^# GROUP:' "$f" 2>/dev/null | sed 's/^# GROUP: *//' | tr '[:upper:]' '[:lower:]')
        [ -z "$summary" ] && summary="(no description yet)"
        [ -z "$group" ] && group="other"
        printf '%s|%s|%s\n' "$group" "$name" "$summary"
    done
}

main() {
    local rows total g group_rows
    rows=$(scan)
    if [ -z "$rows" ]; then
        echo "No tools found in $SHORTCUTS"
        return 0
    fi
    total=$(printf '%s\n' "$rows" | wc -l | tr -d ' ')
    printf '\033[1mTools\033[0m (%s in %s)\n\n' "$total" "$SHORTCUTS"
    for g in $GROUP_ORDER other; do
        group_rows=$(printf '%s\n' "$rows" | awk -F'|' -v g="$g" '$1==g' | sort -t'|' -k2,2)
        [ -z "$group_rows" ] && continue
        printf '\033[1m%s\033[0m\n' "$g"
        while IFS='|' read -r _ name summary; do
            printf '  %-32s %s\n' "$name" "$summary"
        done <<< "$group_rows"
        echo ""
    done
}

case "${1:-}" in
    --help|-h)
        echo "tools: list installed pipeline tools, grouped, with one-line descriptions"
        echo "Usage: tools [--help]"
        echo "Each tool self-describes via # SUMMARY: and # GROUP: header lines."
        exit 0 ;;
    *) main ;;
esac
