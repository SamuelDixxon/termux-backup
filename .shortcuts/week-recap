#!/data/data/com.termux/files/usr/bin/bash
# SUMMARY: Generate title + description for a week's shorts bundled as one upload
# GROUP: content
# =============================================================================
# week-recap
# =============================================================================
# Generates a title + description for bundling a week's worth of shorts
# into one long-form sandwich upload -- e.g. "Pistol Progress (639-671)".
# Computes the previous full Monday-Sunday range.
#
# EPISODE RANGE:
#   Explicit:  week-recap pistol 639 671   -> uses exactly those numbers.
#   Auto:      week-recap pistol           -> start = counter saved at the
#              last run (week_recap_state.json), end = current counter;
#              this run's end becomes next run's start.
#
# USAGE:
#   week-recap                         pick the segment from a dialog
#   week-recap pistol                  auto range, previous Mon-Sun
#   week-recap pistol 639 671          explicit range
#   week-recap pistol --this-week      current week instead of previous
#
# INSTALL:
#   cp week-recap ~/.shortcuts/
#   chmod +x ~/.shortcuts/week-recap
#
# DEPENDENCIES:
#   termux-api (dialog for the no-arg picker), jq, python3
# =============================================================================

if [ -z "$HOME" ]; then
    export HOME="/data/data/com.termux/files/home"
fi
export PATH="/data/data/com.termux/files/usr/bin:$PATH"

DATA_FILE="$HOME/.shortcuts/.hidden/segments_data.json"
STATE_FILE="$HOME/.shortcuts/.hidden/week_recap_state.json"

# -- argument parsing -------------------------------------------------------
SEGMENT=""
START_ARG=""
END_ARG=""
THIS_WEEK=false
USED_PICKER=false

for __a in "$@"; do
    case "$__a" in
        --help|-h)
            echo ""
            echo "Usage: week-recap [<segment>] [start end] [--this-week]"
            echo "       (no <segment>: pick from a dialog)"
            echo ""
            echo "  start end     Explicit episode range, e.g. 639 671"
            echo "  --this-week   Use the current week instead of previous Mon-Sun"
            echo ""
            echo "Examples:"
            echo "  week-recap"
            echo "  week-recap pistol"
            echo "  week-recap pistol 639 671"
            exit 0
            ;;
    esac
done

ARGS=("$@")
i=0
while [ $i -lt ${#ARGS[@]} ]; do
    arg="${ARGS[$i]}"
    case "$arg" in
        --this-week) THIS_WEEK=true ;;
        --*)         echo "x unknown option: $arg"; exit 1 ;;
        *)
            if [ -z "$SEGMENT" ]; then
                SEGMENT="$arg"
            elif [ -z "$START_ARG" ]; then
                START_ARG="$arg"
            elif [ -z "$END_ARG" ]; then
                END_ARG="$arg"
            fi
            ;;
    esac
    i=$(( i + 1 ))
done

if [ -n "$START_ARG" ] && [ -z "$END_ARG" ]; then
    echo "x give both a start and an end episode (e.g. week-recap pistol 639 671)"
    exit 1
fi

if [ ! -f "$DATA_FILE" ]; then
    echo "x segments_data.json not found: $DATA_FILE"
    exit 1
fi

# -- segment picker (no args, e.g. Termux:Widget tap) -------------------------
if [ -z "$SEGMENT" ]; then
    USED_PICKER=true
    for _cmd in termux-dialog jq python3; do
        command -v "$_cmd" >/dev/null 2>&1 || { echo "x $_cmd not found -- pkg install termux-api jq python"; exit 1; }
    done
    __names="$(python3 -c "
import json
d = json.load(open('$DATA_FILE'))
segs = d['segments'] if isinstance(d, dict) else d
print(','.join(s['name'] for s in segs))
")"
    [ -z "$__names" ] && { echo "x could not read segments from $DATA_FILE"; exit 1; }
    echo "  [waiting on dialog] Pick segment for week-recap -- check the popup on your screen" >&2
    SEGMENT="$(termux-dialog radio -v "$__names" -t "Week recap for which segment?" | jq -r '.text // ""')"
    [ -z "$SEGMENT" ] && { echo "No segment chosen. Exiting."; exit 0; }
fi

# -- resolve segment + episode range in ONE python pass -----------------------
__res="$(python3 - "$SEGMENT" "$DATA_FILE" "$STATE_FILE" "$START_ARG" "$END_ARG" <<'PYEOF'
import json, os, sys
want, data_path, state_path, start_arg, end_arg = sys.argv[1:6]
d = json.load(open(data_path))
segs = d['segments'] if isinstance(d, dict) else d
m = [s for s in segs if s['name'] == want] or \
    [s for s in segs if s['name'].lower() == want.lower()]
if not m:
    sys.exit(0)
name = m[0]['name']
counter = m[0].get('counter', 0)
end = int(end_arg) if end_arg else counter
if start_arg:
    start = int(start_arg)
else:
    state = {}
    if os.path.exists(state_path):
        state = json.load(open(state_path))
    start = state.get(name, end)
    state[name] = end
    os.makedirs(os.path.dirname(state_path), exist_ok=True)
    json.dump(state, open(state_path, 'w'), indent=2)
print('%s\t%d\t%d' % (name, start, end))
PYEOF
)"
if [ -z "$__res" ]; then
    echo "x Segment '$SEGMENT' not found in segments_data.json"
    exit 1
fi
SEGMENT="$(echo "$__res" | cut -f1)"
START_COUNTER="$(echo "$__res" | cut -f2)"
END_COUNTER="$(echo "$__res" | cut -f3)"

# -- date range: previous full Monday-Sunday (or current with --this-week) ---
# %u gives ISO weekday, 1=Monday..7=Sunday.
TODAY_DOW=$(date +%u)
CURRENT_MONDAY=$(date -d "-$((TODAY_DOW - 1)) days" +%Y-%m-%d)

if $THIS_WEEK; then
    RANGE_MONDAY="$CURRENT_MONDAY"
else
    RANGE_MONDAY=$(date -d "$CURRENT_MONDAY -7 days" +%Y-%m-%d)
fi
RANGE_SUNDAY=$(date -d "$RANGE_MONDAY +6 days" +%Y-%m-%d)
RANGE_LABEL="$(date -d "$RANGE_MONDAY" '+%b %-d') - $(date -d "$RANGE_SUNDAY" '+%b %-d, %Y')"

REPS=$((END_COUNTER - START_COUNTER))
SEG_TITLE="$(echo "${SEGMENT:0:1}" | tr '[:lower:]' '[:upper:]')${SEGMENT:1}"

echo ""
echo "Title:"
echo "  ${SEG_TITLE} Progress (${START_COUNTER}-${END_COUNTER})"
echo ""
echo "Description:"
echo "  A week of ${SEGMENT} training, ${RANGE_LABEL}. ${REPS} logged this"
echo "  week -- every short from these sessions, bundled into one recap."
echo "  Segment #${START_COUNTER} through #${END_COUNTER}."
echo ""

# The deliverable: title + description as one clean block.
CLIP_TEXT="${SEG_TITLE} Progress (${START_COUNTER}-${END_COUNTER})

A week of ${SEGMENT} training, ${RANGE_LABEL}. ${REPS} logged this week -- every short from these sessions, bundled into one recap. Segment #${START_COUNTER} through #${END_COUNTER}."

# Picked via dialog (widget flow): show the block in an editable dialog first
# (numbers can be tweaked there); whatever is in the box on OK is what gets
# copied to the clipboard.
if $USED_PICKER && command -v termux-dialog >/dev/null 2>&1; then
    __edited="$(termux-dialog text -t "Week Recap" -i "$CLIP_TEXT" | jq -r '.text // ""' 2>/dev/null)"
    [ -n "$__edited" ] && CLIP_TEXT="$__edited"
fi

if command -v termux-clipboard-set >/dev/null 2>&1; then
    printf '%s' "$CLIP_TEXT" | termux-clipboard-set
    echo "(Copied title + description to clipboard)"
fi
