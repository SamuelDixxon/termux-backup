#!/data/data/com.termux/files/usr/bin/bash
# SUMMARY: Generate title + description for a week's shorts bundled as one upload
# GROUP: content
# =============================================================================
# week-recap
# =============================================================================
# Generates a title + description for bundling a week's worth of shorts
# into one long-form sandwich upload -- e.g. "Pistol Progress (660-671)".
# Computes the previous full Monday-Sunday range, and tracks each
# segment's counter between runs so the range is automatic after the
# first use.
#
# HOW THE COUNTER RANGE WORKS:
#   End   = the segment's counter right now.
#   Start = the counter value the last time week-recap ran for this
#           segment (saved in week_recap_state.json), or --start on first use.
#
# USAGE:
#   week-recap                         pick the segment from a dialog
#   week-recap pistol                  previous Mon-Sun, auto range
#   week-recap pistol --start 573      first run: set the starting point
#   week-recap pistol --this-week      current week instead of previous
#
# INSTALL:
#   cp week-recap ~/.shortcuts/
#   chmod +x ~/.shortcuts/week-recap
#
# DEPENDENCIES:
#   termux-api (dialog for the no-arg picker), jq, python3
# =============================================================================

if [ -z "$HOME" ]; then
    export HOME="/data/data/com.termux/files/home"
fi
export PATH="/data/data/com.termux/files/usr/bin:$PATH"

DATA_FILE="$HOME/.shortcuts/.hidden/segments_data.json"
STATE_FILE="$HOME/.shortcuts/.hidden/week_recap_state.json"

# -- argument parsing -------------------------------------------------------
SEGMENT=""
START_OVERRIDE=""
THIS_WEEK=false

for __a in "$@"; do
    case "$__a" in
        --help|-h)
            echo ""
            echo "Usage: week-recap [<segment>] [--start N] [--this-week]"
            echo "       (no <segment>: pick from a dialog)"
            echo ""
            echo "  --start N     First run: set the starting counter manually"
            echo "  --this-week   Use the current week instead of previous Mon-Sun"
            echo ""
            echo "Examples:"
            echo "  week-recap"
            echo "  week-recap pistol"
            echo "  week-recap pistol --start 573"
            exit 0
            ;;
    esac
done

ARGS=("$@")
i=0
while [ $i -lt ${#ARGS[@]} ]; do
    arg="${ARGS[$i]}"
    case "$arg" in
        --start)     i=$(( i + 1 )); START_OVERRIDE="${ARGS[$i]}" ;;
        --this-week) THIS_WEEK=true ;;
        --*)         echo "x unknown option: $arg"; exit 1 ;;
        *)           [ -z "$SEGMENT" ] && SEGMENT="$arg" ;;
    esac
    i=$(( i + 1 ))
done

if [ ! -f "$DATA_FILE" ]; then
    echo "x segments_data.json not found: $DATA_FILE"
    exit 1
fi

# -- segment picker (no args, e.g. Termux:Widget tap) -------------------------
if [ -z "$SEGMENT" ]; then
    for _cmd in termux-dialog jq python3; do
        command -v "$_cmd" >/dev/null 2>&1 || { echo "x $_cmd not found -- pkg install termux-api jq python"; exit 1; }
    done
    __vals="$(python3 - "$DATA_FILE" <<'PYEOF'
import json, sys
d = json.load(open(sys.argv[1]))
segs = d['segments'] if isinstance(d, dict) else d
print(','.join(s['name'] for s in segs))
print(' | '.join('%s (%d)' % (s['name'], s.get('counter', 0)) for s in segs))
PYEOF
)"
    __names="$(echo "$__vals" | sed -n '1p')"
    [ -z "$__names" ] && { echo "x could not read segments from $DATA_FILE"; exit 1; }
    __title="Week recap for which segment? $(echo "$__vals" | sed -n '2p')"
    echo "  [waiting on dialog] Pick segment for week-recap -- check the popup on your screen" >&2
    SEGMENT="$(termux-dialog radio -v "$__names" -t "$__title" | jq -r '.text // ""')"
    [ -z "$SEGMENT" ] && { echo "No segment chosen. Exiting."; exit 0; }
fi

# -- resolve segment: exact match, then case-insensitive ----------------------
__res="$(python3 - "$SEGMENT" "$DATA_FILE" <<'PYEOF'
import json, sys
want, path = sys.argv[1], sys.argv[2]
d = json.load(open(path))
segs = d['segments'] if isinstance(d, dict) else d
m = [s for s in segs if s['name'] == want] or \
    [s for s in segs if s['name'].lower() == want.lower()]
if m:
    print('%s\t%d' % (m[0]['name'], m[0].get('counter', 0)))
PYEOF
)"
if [ -z "$__res" ]; then
    echo "x Segment '$SEGMENT' not found in segments_data.json"
    exit 1
fi
SEGMENT="$(echo "$__res" | cut -f1)"
END_COUNTER="$(echo "$__res" | cut -f2)"

# -- date range: previous full Monday-Sunday (or current with --this-week) ---
# %u gives ISO weekday, 1=Monday..7=Sunday.
TODAY_DOW=$(date +%u)
CURRENT_MONDAY=$(date -d "-$((TODAY_DOW - 1)) days" +%Y-%m-%d)

if $THIS_WEEK; then
    RANGE_MONDAY="$CURRENT_MONDAY"
else
    RANGE_MONDAY=$(date -d "$CURRENT_MONDAY -7 days" +%Y-%m-%d)
fi
RANGE_SUNDAY=$(date -d "$RANGE_MONDAY +6 days" +%Y-%m-%d)
RANGE_LABEL="$(date -d "$RANGE_MONDAY" '+%b %-d') - $(date -d "$RANGE_SUNDAY" '+%b %-d, %Y')"

# -- counter range ------------------------------------------------------------
if [ -n "$START_OVERRIDE" ]; then
    START_COUNTER="$START_OVERRIDE"
else
    START_COUNTER="$(python3 - "$SEGMENT" "$END_COUNTER" "$STATE_FILE" <<'PYEOF'
import json, os, sys
seg, end, path = sys.argv[1], sys.argv[2], sys.argv[3]
print(json.load(open(path)).get(seg, end) if os.path.exists(path) else end)
PYEOF
)"
fi

# -- save this run's counter as next run's baseline ---------------------------
python3 - "$SEGMENT" "$END_COUNTER" "$STATE_FILE" <<'PYEOF'
import json, os, sys
seg, end, path = sys.argv[1], int(sys.argv[2]), sys.argv[3]
state = {}
if os.path.exists(path):
    state = json.load(open(path))
state[seg] = end
os.makedirs(os.path.dirname(path), exist_ok=True)
json.dump(state, open(path, 'w'), indent=2)
PYEOF

REPS=$((END_COUNTER - START_COUNTER))
SEG_TITLE="$(echo "${SEGMENT:0:1}" | tr '[:lower:]' '[:upper:]')${SEGMENT:1}"

echo ""
echo "Title:"
echo "  ${SEG_TITLE} Progress (${START_COUNTER}-${END_COUNTER})"
echo ""
echo "Description:"
echo "  A week of ${SEGMENT} training, ${RANGE_LABEL}. ${REPS} logged this"
echo "  week -- every short from these sessions, bundled into one recap."
echo "  Segment #${START_COUNTER} through #${END_COUNTER}."
echo ""
echo "(Baseline saved for next run: ${END_COUNTER})"
